{
  "hosting": {
    "site": "eurobaza",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "EuroBaza для ИИ/**",
      "*.md",
      "package.json",
      "package-lock.json",
      "bump-version.js",
      "check.js",
      "update-context.js",
      "tests/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/@(sw.js|version.json|index.html|admin.html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
